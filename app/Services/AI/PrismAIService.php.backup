<?php

declare(strict_types=1);

namespace App\Services\AI;

use Exception;
use Illuminate\Support\Facades\Log;
use Prism\Prism\Enums\Provider;
use Prism\Prism\Prism;

/**
 * Simplified Prism AI Service using the Prism package's unified API.
 *
 * Leverages Prism's built-in provider support instead of reimplementing everything.
 */
class PrismAIService
{
    /** @var array<string, array{provider: Provider, model: string}> */
    protected array $modelConfigs = [
        'gpt-4' => [
            'provider' => Provider::OpenAI,
            'model' => 'gpt-4o',
        ],
        'claude-3.5-sonnet' => [
            'provider' => Provider::Anthropic,
            'model' => 'claude-3-5-sonnet-20241022',
        ],
        'gemini-1.5-pro' => [
            'provider' => Provider::Gemini,
            'model' => 'gemini-1.5-pro',
        ],
        'grok-beta' => [
            'provider' => Provider::XAI,
            'model' => 'grok-beta',
        ],
    ];

    /**
     * Check if a model is available based on API key configuration.
     */
    public function isModelAvailable(string $modelId): bool
    {
        return isset($this->modelConfigs[$modelId]);
    }

    /**
     * Generate names using Prism's unified API.
     *
     * @param  array<string, mixed>  $parameters
     * @return array<int, string>
     */
    public function generateNames(string $modelId, string $prompt, array $parameters = []): array
    {
        if (! $this->isModelAvailable($modelId)) {
            throw new Exception("Model {$modelId} is not available");
        }

        $config = $this->modelConfigs[$modelId];

        try {
            // Use Prism's simple, unified API
            $response = Prism::text()
                ->using($config['provider'], $config['model'])
                ->withPrompt($prompt)
                ->asText();

            // Extract names from the response
            return $this->extractNamesFromResponse($response->text);

        } catch (Exception $e) {
            Log::error("Prism AI generation failed for {$modelId}", [
                'error' => $e->getMessage(),
                'model' => $modelId,
            ]);

            // Return dynamic fallback names instead of static ones
            return $this->generateFallbackNames($prompt, $modelId);
        }
    }

    /**
     * Optimize prompt for specific model and mode with advanced business intelligence.
     */
    public function optimizePrompt(string $modelId, string $basePrompt, string $mode, bool $deepThinking): string
    {
        // Enhanced business analysis and context detection
        $businessContext = $this->analyzeBusinessContext($basePrompt);

        // Model-specific optimization
        $modelOptimizations = $this->getModelSpecificOptimizations($modelId);

        // Build sophisticated system prompt
        $systemPrompt = $this->buildAdvancedSystemPrompt($businessContext, $modelOptimizations);

        // Create detailed mode-specific instructions
        $modeInstructions = $this->buildModeInstructions($mode, $businessContext);

        // Add industry-specific guidance
        $industryGuidance = $this->buildIndustryGuidance($businessContext);

        // Create audience-aware recommendations
        $audienceGuidance = $this->buildAudienceGuidance($businessContext);

        // Add naming psychology principles
        $psychologyPrinciples = $this->buildNamingPsychology($mode, $businessContext);

        // Create competitive differentiation guidance
        $competitiveGuidance = $this->buildCompetitiveGuidance($businessContext);

        // Build deep thinking enhancements
        $thinkingEnhancements = $deepThinking ? $this->buildDeepThinkingPrompts($businessContext) : '';

        // Create domain-friendly considerations
        $domainGuidance = $this->buildDomainGuidance($mode);

        // Add model-specific examples and optimizations
        $examplesAndOptimizations = $this->buildModelExamples($modelId, $mode, $businessContext);

        // Combine all elements into comprehensive prompt
        return implode("\n\n", array_filter([
            $systemPrompt,
            $modeInstructions,
            $industryGuidance,
            $audienceGuidance,
            $psychologyPrinciples,
            $competitiveGuidance,
            $thinkingEnhancements,
            $domainGuidance,
            $examplesAndOptimizations,
            "BUSINESS CONCEPT TO NAME: {$basePrompt}"
        ]));
    }

    /**
     * Get model capabilities and limits.
     *
     * @return array<string, mixed>
     */
    public function getModelCapabilities(string $modelId): array
    {
        $capabilities = [
            'gpt-4' => [
                'max_tokens' => 4096,
                'supports_streaming' => true,
                'cost_per_1k_tokens' => 0.03,
            ],
            'claude-3.5-sonnet' => [
                'max_tokens' => 8192,
                'supports_streaming' => true,
                'cost_per_1k_tokens' => 0.003,
            ],
            'gemini-1.5-pro' => [
                'max_tokens' => 2048,
                'supports_streaming' => true,
                'cost_per_1k_tokens' => 0.00125,
            ],
            'grok-beta' => [
                'max_tokens' => 4096,
                'supports_streaming' => true,
                'cost_per_1k_tokens' => 0.005,
            ],
        ];

        return $capabilities[$modelId] ?? [
            'max_tokens' => 4096,
            'supports_streaming' => false,
            'cost_per_1k_tokens' => 0.01,
        ];
    }

    /**
     * Extract business names from AI response text.
     *
     * @return array<int, string>
     */
    protected function extractNamesFromResponse(string $responseText): array
    {
        // Split by lines and extract numbered items
        $lines = array_filter(array_map('trim', explode("\n", $responseText)));
        $names = [];

        foreach ($lines as $line) {
            // Match patterns like "1. BusinessName" or "1) BusinessName" or just "BusinessName"
            if (preg_match('/^\d+[\.\)]\s*(.+)/', $line, $matches)) {
                $names[] = trim($matches[1]);
            } elseif (! empty($line) && count($names) < 10) {
                // If no numbering, but we still need names
                $names[] = trim($line);
            }
        }

        // Ensure we have exactly 10 names
        $names = array_slice($names, 0, 10);

        // If we don't have enough names, pad with generated ones
        while (count($names) < 10) {
            $names[] = $this->generateSingleFallbackName(count($names) + 1);
        }

        return $names;
    }

    /**
     * Generate fallback names when AI fails.
     *
     * @return array<int, string>
     */
    protected function generateFallbackNames(string $prompt, string $modelId): array
    {
        // Extract business context from prompt
        $businessWord = $this->extractBusinessWord($prompt);

        $suffixes = match ($modelId) {
            'gpt-4' => ['Pro', 'Hub', 'Core', 'AI', 'Labs', 'Tech', 'Plus', 'Max', 'Zone', 'Link'],
            'claude-3.5-sonnet' => ['Studio', 'Works', 'Craft', 'House', 'Space', 'Mind', 'Logic', 'Smart', 'Swift', 'Wise'],
            'gemini-1.5-pro' => ['Digital', 'Cloud', 'Net', 'Web', 'App', 'System', 'Data', 'Code', 'Flow', 'Sync'],
            'grok-beta' => ['X', 'Edge', 'Boost', 'Rush', 'Spark', 'Volt', 'Pulse', 'Wave', 'Beat', 'Fire'],
            default => ['Pro', 'Hub', 'Core', 'Zone', 'Labs', 'Tech', 'Plus', 'Max', 'AI', 'Link']
        };

        $names = [];
        foreach ($suffixes as $suffix) {
            $names[] = $businessWord.$suffix;
        }

        return $names;
    }

    /**
     * Extract first meaningful word from business prompt.
     */
    protected function extractBusinessWord(string $prompt): string
    {
        // Extract first meaningful word from the prompt
        $words = array_filter(explode(' ', trim($prompt)));
        $businessWord = 'Business';

        foreach ($words as $word) {
            $cleaned = preg_replace('/[^a-zA-Z]/', '', $word);
            if (strlen($cleaned) >= 3) {
                $businessWord = ucfirst(strtolower($cleaned));
                break;
            }
        }

        return $businessWord;
    }

    /**
     * Generate a single fallback name.
     */
    protected function generateSingleFallbackName(int $index): string
    {
        $prefixes = ['Smart', 'Quick', 'Pro', 'Ultra', 'Meta', 'Auto', 'Flex', 'Nova', 'Core', 'Peak'];
        $suffixes = ['Works', 'Labs', 'Hub', 'Pro', 'Tech', 'Zone', 'Plus', 'AI', 'Max', 'Link'];

        $prefixIndex = $index % count($prefixes);
        $suffixIndex = ($index * 2) % count($suffixes);

        return $prefixes[$prefixIndex].$suffixes[$suffixIndex];
    }

    /**
     * Analyze business context with advanced pattern recognition.
     *
     * @return array<string, mixed>
     */
    protected function analyzeBusinessContext(string $businessIdea): array
    {
        $lowerIdea = strtolower($businessIdea);

        // Industry classification with confidence scoring
        $industries = [
            'technology' => ['app', 'software', 'platform', 'digital', 'ai', 'tech', 'saas', 'cloud', 'data', 'algorithm', 'code', 'development', 'programming', 'system', 'automation'],
            'healthcare' => ['health', 'medical', 'wellness', 'fitness', 'therapy', 'clinic', 'doctor', 'patient', 'medicine', 'treatment', 'hospital', 'care', 'healing'],
            'finance' => ['finance', 'money', 'banking', 'investment', 'trading', 'crypto', 'payment', 'financial', 'budget', 'accounting', 'loan', 'credit', 'insurance'],
            'education' => ['education', 'learning', 'teaching', 'school', 'course', 'training', 'student', 'university', 'knowledge', 'study', 'academic', 'tutorial'],
            'food' => ['food', 'restaurant', 'cooking', 'recipe', 'kitchen', 'chef', 'dining', 'cuisine', 'meal', 'bakery', 'cafe', 'catering', 'delivery'],
            'retail' => ['shop', 'store', 'retail', 'marketplace', 'ecommerce', 'selling', 'product', 'shopping', 'commerce', 'merchant', 'goods', 'inventory'],
            'real_estate' => ['property', 'real estate', 'housing', 'rental', 'home', 'apartment', 'building', 'construction', 'architecture'],
            'travel' => ['travel', 'tourism', 'vacation', 'hotel', 'booking', 'trip', 'flight', 'destination', 'adventure', 'journey'],
            'entertainment' => ['entertainment', 'gaming', 'music', 'movie', 'media', 'content', 'streaming', 'video', 'podcast', 'art', 'creative'],
            'logistics' => ['delivery', 'shipping', 'logistics', 'transport', 'supply chain', 'warehouse', 'distribution', 'courier', 'freight'],
            'professional_services' => ['consulting', 'advisory', 'legal', 'marketing', 'agency', 'service', 'professional', 'business', 'strategy'],
            'sustainability' => ['green', 'eco', 'sustainable', 'environment', 'renewable', 'clean', 'organic', 'natural', 'carbon', 'climate']
        ];

        $detectedIndustry = 'general';
        $confidence = 0;

        foreach ($industries as $industry => $keywords) {
            $matches = 0;
            foreach ($keywords as $keyword) {
                if (str_contains($lowerIdea, $keyword)) {
                    $matches++;
                }
            }
            $currentConfidence = $matches / count($keywords);
            if ($currentConfidence > $confidence) {
                $confidence = $currentConfidence;
                $detectedIndustry = $industry;
            }
        }

        // Business model detection
        $businessModels = [
            'b2b' => ['business', 'enterprise', 'corporate', 'company', 'organization', 'professional', 'team', 'workplace'],
            'b2c' => ['consumer', 'customer', 'user', 'personal', 'individual', 'family', 'people', 'public'],
            'marketplace' => ['marketplace', 'platform', 'connect', 'match', 'network', 'community', 'peer-to-peer'],
            'saas' => ['software', 'service', 'subscription', 'cloud', 'online', 'platform', 'tool', 'dashboard']
        ];

        $businessModel = 'general';
        foreach ($businessModels as $model => $keywords) {
            foreach ($keywords as $keyword) {
                if (str_contains($lowerIdea, $keyword)) {
                    $businessModel = $model;
                    break 2;
                }
            }
        }

        // Target audience analysis
        $audienceIndicators = [
            'millennials' => ['millennial', 'young adult', 'trendy', 'social', 'mobile', 'app', 'instagram'],
            'professionals' => ['professional', 'business', 'corporate', 'executive', 'career', 'workplace'],
            'families' => ['family', 'parent', 'child', 'kid', 'home', 'household', 'domestic'],
            'developers' => ['developer', 'programmer', 'code', 'api', 'technical', 'engineering', 'dev'],
            'entrepreneurs' => ['startup', 'entrepreneur', 'small business', 'founder', 'venture', 'indie'],
            'seniors' => ['senior', 'elderly', 'retirement', 'mature', 'older adult'],
            'students' => ['student', 'college', 'university', 'academic', 'learning', 'education']
        ];

        $targetAudience = 'general';
        foreach ($audienceIndicators as $audience => $keywords) {
            foreach ($keywords as $keyword) {
                if (str_contains($lowerIdea, $keyword)) {
                    $targetAudience = $audience;
                    break 2;
                }
            }
        }

        // Emotional tone detection
        $emotionalTones = [
            'innovative' => ['innovative', 'cutting-edge', 'revolutionary', 'advanced', 'next-gen', 'breakthrough'],
            'trustworthy' => ['secure', 'reliable', 'trusted', 'safe', 'proven', 'established', 'professional'],
            'friendly' => ['friendly', 'easy', 'simple', 'welcoming', 'approachable', 'helpful', 'community'],
            'premium' => ['premium', 'luxury', 'high-end', 'exclusive', 'elite', 'sophisticated', 'refined'],
            'efficient' => ['fast', 'quick', 'efficient', 'streamline', 'optimize', 'automated', 'smart']
        ];

        $emotionalTone = 'neutral';
        foreach ($emotionalTones as $tone => $keywords) {
            foreach ($keywords as $keyword) {
                if (str_contains($lowerIdea, $keyword)) {
                    $emotionalTone = $tone;
                    break 2;
                }
            }
        }

        return [
            'industry' => $detectedIndustry,
            'confidence' => $confidence,
            'business_model' => $businessModel,
            'target_audience' => $targetAudience,
            'emotional_tone' => $emotionalTone,
            'word_count' => str_word_count($businessIdea),
            'contains_tech_terms' => preg_match('/\b(app|software|platform|digital|ai|tech|saas|api|cloud|data)\b/i', $businessIdea),
            'complexity_level' => strlen($businessIdea) > 200 ? 'complex' : (strlen($businessIdea) > 50 ? 'moderate' : 'simple')
        ];
    }

    /**
     * Get model-specific optimizations.
     *
     * @return array<string, mixed>
     */
    protected function getModelSpecificOptimizations(string $modelId): array
    {
        return match ($modelId) {
            'gpt-4' => [
                'style' => 'analytical',
                'strength' => 'logical reasoning',
                'focus' => 'structured thinking and comprehensive analysis',
                'tone' => 'professional and thorough'
            ],
            'claude-3.5-sonnet' => [
                'style' => 'creative',
                'strength' => 'nuanced understanding',
                'focus' => 'creative wordplay and cultural awareness',
                'tone' => 'thoughtful and innovative'
            ],
            'gemini-1.5-pro' => [
                'style' => 'collaborative',
                'strength' => 'multi-perspective thinking',
                'focus' => 'diverse approaches and cultural sensitivity',
                'tone' => 'inclusive and comprehensive'
            ],
            'grok-beta' => [
                'style' => 'bold',
                'strength' => 'unconventional thinking',
                'focus' => 'disruptive and memorable concepts',
                'tone' => 'edgy and distinctive'
            ],
            default => [
                'style' => 'balanced',
                'strength' => 'general purpose',
                'focus' => 'well-rounded approach',
                'tone' => 'professional'
            ]
        };
    }

    /**
     * Build advanced system prompt with business intelligence.
     */
    protected function buildAdvancedSystemPrompt(array $businessContext, array $modelOptimizations): string
    {
        $basePrompt = "You are an expert business naming consultant and brand strategist with 20+ years of experience creating memorable, market-ready business names. Your expertise spans across industries and you understand the psychology of successful branding.

🎯 PRIMARY OBJECTIVE: Generate exactly 10 unique, professional business names, numbered 1-10, one per line.

🚫 STRICT AVOIDANCE RULES:
- NO generic suffixes: Tech, Labs, Solutions, Systems, Digital, Hub, Pro, Plus, Max, AI, App, Soft, Ware, Inc, LLC
- NO unnecessary prefixes: My, Get, The, Smart, Auto, Quick, Easy, Super, Ultra, Meta, Next
- NO obvious descriptive combinations that sound like features rather than brands
- NO overused buzzwords: Cloud, Sync, Connect, Link, Net, Web, Cyber, E-, i-, -ly, -ify
- NO made-up words that are hard to pronounce or remember

✅ NAMING EXCELLENCE CRITERIA:
- Memorable and distinctive (passes the 'radio test' - clear when spoken)
- Easy to spell and pronounce
- Available as a domain name (.com preferred)
- Scalable beyond initial business scope
- Emotionally resonant with target audience
- Legally protectable (trademark-friendly)
- Works across cultures and languages
- Ages well over time";

        // Add model-specific enhancement
        $modelEnhancement = "LEVERAGE YOUR {$modelOptimizations['strength']} to create names with a {$modelOptimizations['style']} approach, maintaining a {$modelOptimizations['tone']} tone while {$modelOptimizations['focus']}.";

        return $basePrompt . "\n\n" . $modelEnhancement;
    }

    /**
     * Build detailed mode-specific instructions.
     */
    protected function buildModeInstructions(string $mode, array $businessContext): string
    {
        $modeInstructions = match ($mode) {
            'creative' => "🎨 CREATIVE MODE - UNLEASH INNOVATION
Generate imaginative, artistic names that capture attention and spark curiosity. Think beyond literal descriptions.

CREATIVE TECHNIQUES TO USE:
- Metaphorical connections (like 'Apple' for computers)
- Invented words that sound natural (like 'Kodak' or 'Xerox')
- Unexpected word combinations that create new meaning
- Abstract concepts that evoke the right feeling
- Playful linguistic twists and wordplay
- Cultural references that resonate

EMOTIONAL GOALS:
- Intrigue and curiosity ('What is this interesting company?')
- Memorability through uniqueness
- Positive associations and feelings
- Sense of innovation and forward-thinking

INSPIRATION SOURCES: Nature, emotions, mythology, art, music, literature, science
AVOID: Literal descriptions, obvious industry terms, generic creative words",

            'professional' => "🏢 PROFESSIONAL MODE - BUILD AUTHORITY
Generate sophisticated, authoritative names that command respect in business environments.

PROFESSIONAL QUALITIES:
- Conveys expertise, competence, and reliability
- Sounds established and trustworthy
- Appropriate for boardrooms and C-suite conversations
- Works well on business cards, proposals, and contracts
- Suggests depth of knowledge and experience

LINGUISTIC PATTERNS:
- Strong consonant sounds (K, T, D sounds convey authority)
- Classical roots or Latin/Greek derivations
- Firm, decisive syllable patterns
- International appeal and pronunciation
- Timeless rather than trendy

MARKET POSITIONING:
- Premium market positioning
- B2B relationship building
- Long-term client partnerships
- Professional service excellence

AVOID: Casual language, trendy slang, overly creative spellings, youth-oriented terms",

            'brandable' => "🚀 BRANDABLE MODE - MARKET DOMINATION
Generate names optimized for marketing, memorability, and viral potential.

BRANDABILITY FACTORS:
- Extremely memorable and 'sticky'
- Easy to say, spell, and remember
- Works perfectly in advertising and social media
- Creates immediate brand recognition
- Generates word-of-mouth naturally

MARKETING OPTIMIZATION:
- Short enough for logos and signage
- Sounds great in radio/TV commercials
- Hashtag-friendly for social media
- Clear pronunciation across accents
- Positive connotations in multiple languages

VIRAL QUALITIES:
- Easy to recommend to friends
- Creates curiosity about the business
- Stands out in crowded marketplaces
- Develops emotional connection with customers
- Becomes part of everyday vocabulary

MARKET PSYCHOLOGY:
- Triggers positive emotions and associations
- Creates premium perception without pretension
- Appeals to aspirational customer desires

AVOID: Complex spellings, negative connotations, hard-to-pronounce combinations",

            'tech-focused' => "💻 TECH-FOCUSED MODE - DEVELOPER APPEAL
Generate names that resonate with technical audiences while avoiding clichéd tech terminology.

TECHNICAL RESONANCE:
- Subtle references to programming concepts or methodologies
- Clean, efficient-sounding names
- Appeals to developer aesthetics and values
- Suggests precision, performance, and reliability
- Honors the craft and art of technology

DEVELOPER-FRIENDLY QUALITIES:
- Short, efficient (like good code)
- Logical and purposeful structure
- Easy to type and remember
- Plays well with technical documentation
- Fits developer tool naming conventions

SOPHISTICATED TECH CONCEPTS:
- Mathematical or scientific principles
- Computing history and pioneers
- Programming paradigms and patterns
- System architecture concepts
- Data structures and algorithms

CULTURAL APPEAL:
- Resonates with maker culture
- Appeals to open-source community values
- Suggests innovation without hype
- Technical elegance and simplicity

AVOID: Obvious tech suffixes, marketing-speak, artificial complexity, enterprise buzzwords"
        };

        // Add industry-specific enhancement if relevant
        if ($businessContext['industry'] !== 'general') {
            $industryNote = "\n\n📍 INDUSTRY CONTEXT: This is a {$businessContext['industry']} business, so consider industry-specific naming conventions, audience expectations, and market dynamics.";
            $modeInstructions .= $industryNote;
        }

        return $modeInstructions;
    }

