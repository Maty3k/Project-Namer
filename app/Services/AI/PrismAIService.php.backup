    /**
     * Build audience-aware guidance.
     */
    protected function buildAudienceGuidance(array $businessContext): string
    {
        if ($businessContext['target_audience'] === 'general') {
            return '';
        }

        return match ($businessContext['target_audience']) {
            'millennials' => "👥 MILLENNIAL AUDIENCE STRATEGY
- Authentic, purpose-driven brand messaging
- Social media friendly and shareable names
- Values-based branding with social consciousness
- Mobile-first thinking and digital-native appeal
- Balance nostalgia with innovation
- Consider lifestyle integration and personal identity",

            'professionals' => "💼 PROFESSIONAL AUDIENCE STRATEGY
- Career advancement and productivity focus
- Time-efficient and results-oriented messaging
- Network building and professional development appeal
- Industry credibility and thought leadership
- Work-life balance and efficiency optimization
- Premium positioning with ROI justification",

            'families' => "👨‍👩‍👧‍👦 FAMILY AUDIENCE STRATEGY
- Safety, security, and child-friendly considerations
- Value for money and practical benefits
- Convenience and time-saving appeal
- Multi-generational usage and appeal
- Trust and reliability over flashy innovation
- Community and connection emphasis",

            'developers' => "👨‍💻 DEVELOPER AUDIENCE STRATEGY
- Technical precision and performance focus
- Open-source community values and ethics
- Problem-solving and efficiency optimization
- Documentation-friendly and API-compatible naming
- Respect for developer time and intelligence
- Innovation without unnecessary complexity",

            'entrepreneurs' => "🚀 ENTREPRENEUR AUDIENCE STRATEGY
- Growth, scaling, and opportunity focus
- Bootstrap-friendly and cost-effective positioning
- Speed to market and competitive advantage
- Networking and partnership potential
- Risk-taking balanced with smart decisions
- Success stories and achievement orientation",

            'seniors' => "👴 SENIOR AUDIENCE STRATEGY
- Clarity, simplicity, and ease of use
- Trust and established reputation emphasis
- Customer service and personal attention
- Traditional values with modern convenience
- Health, security, and family considerations
- Respectful and dignified brand messaging",

            'students' => "🎓 STUDENT AUDIENCE STRATEGY
- Affordability and value optimization
- Learning and skill development focus
- Future career and opportunity building
- Peer recommendation and social proof
- Flexibility and adaptability to changing needs
- Academic success and achievement support",

            default => ''
        };
    }

    /**
     * Build naming psychology principles.
     */
    protected function buildNamingPsychology(string $mode, array $businessContext): string
    {
        $basepsychology = "🧠 NAMING PSYCHOLOGY PRINCIPLES

PHONETIC PSYCHOLOGY:
- Hard consonants (K, T, P, B) convey strength and reliability
- Soft sounds (L, M, N, R) suggest friendliness and approachability
- Vowel sounds affect perception: 'A' sounds (energetic), 'O' sounds (stable), 'I' sounds (innovative)
- Alliteration increases memorability but avoid overuse
- Rhythm and flow matter - test how it sounds when spoken aloud

COGNITIVE PSYCHOLOGY:
- Shorter names are easier to remember and process
- Familiar word patterns reduce cognitive load
- Unique positioning creates distinctive memory traces
- Avoid names that are too similar to major competitors
- Consider mental availability and recall triggers

EMOTIONAL PSYCHOLOGY:
- Names create immediate emotional associations
- Cultural context affects emotional response
- Personal relevance increases engagement
- Positive associations compound over time
- Avoid unintended negative connotations";

        // Add emotional tone specific guidance
        if ($businessContext['emotional_tone'] !== 'neutral') {
            $toneGuidance = match ($businessContext['emotional_tone']) {
                'innovative' => "\nINNOVATIVE TONE: Use forward-looking language, suggest breakthrough thinking, avoid traditional/conservative terms",
                'trustworthy' => "\nTRUSTWORTHY TONE: Emphasize reliability, use established word patterns, avoid risky or experimental terms",
                'friendly' => "\nFRIENDLY TONE: Choose approachable sounds, avoid intimidating complexity, suggest warmth and welcome",
                'premium' => "\nPREMIUM TONE: Select sophisticated vocabulary, suggest exclusivity, avoid common or budget-oriented terms",
                'efficient' => "\nEFFICIENT TONE: Choose crisp, clean sounds, suggest speed and optimization, avoid lengthy or complex terms",
                default => ''
            };
            $basepsychology .= $toneGuidance;
        }

        return $basepsychology;
    }

    /**
     * Build competitive differentiation guidance.
     */
    protected function buildCompetitiveGuidance(array $businessContext): string
    {
        $guidance = "🏆 COMPETITIVE DIFFERENTIATION STRATEGY

MARKET POSITIONING:
- Research what naming patterns competitors use
- Identify oversaturated naming conventions in the industry
- Find unique positioning angles that aren't being used
- Consider counter-positioning against market leaders
- Think about blue ocean opportunities

DIFFERENTIATION TACTICS:
- Zag when competitors zig with naming approaches
- Use unexpected industry crossovers for fresh perspective
- Avoid following the latest naming trends if everyone is using them
- Consider contrarian approaches that stand out
- Think about what customers actually want vs. what industry provides

TRADEMARK LANDSCAPE:
- Ensure names can be legally protected
- Avoid too-similar names to established brands
- Consider international trademark implications
- Think about domain availability and social media handles
- Plan for brand family growth and extensions";

        // Add industry-specific competitive notes
        if ($businessContext['industry'] === 'technology') {
            $guidance .= "\n\nTECH COMPETITIVE NOTES: Avoid the saturated 'ly', 'ify', and 'app' naming conventions. Stand out from the sea of similar-sounding tech names.";
        } elseif ($businessContext['industry'] === 'finance') {
            $guidance .= "\n\nFINANCE COMPETITIVE NOTES: Move beyond traditional 'trust', 'capital', and 'financial' patterns. Find names that suggest innovation while maintaining credibility.";
        }

        return $guidance;
    }

    /**
     * Build deep thinking enhancement prompts.
     */
    protected function buildDeepThinkingPrompts(array $businessContext): string
    {
        return "🔍 DEEP THINKING MODE ACTIVATED

COMPREHENSIVE ANALYSIS REQUIRED:
Take 30+ seconds to deeply analyze this business concept before generating names. Consider:

STRATEGIC QUESTIONS:
- What is the core problem this business solves?
- Who is the primary customer and what do they really need?
- What makes this business different from every other solution?
- How will customers discover and remember this business?
- What will success look like in 5-10 years?

MARKET DYNAMICS:
- What are the current trends in this industry?
- How might this industry evolve over the next decade?
- What are customers frustrated with in existing solutions?
- Where are the gaps that this business could uniquely fill?
- How does pricing and positioning affect naming strategy?

BRAND EVOLUTION:
- How might this business expand beyond its initial focus?
- What products or services might be added later?
- How will the name work across different customer segments?
- What international expansion considerations exist?
- How will this name age as the business matures?

CUSTOMER JOURNEY:
- How will customers first hear about this business?
- What will make them remember and recommend it?
- How does the name work in different contexts (verbal, written, digital)?
- What emotional journey should the name support?
- How does the name build trust and credibility over time?

EXECUTION CONSIDERATIONS:
- What marketing channels will this business use?
- How will the name work in advertising and content marketing?
- What logo and visual identity possibilities does the name create?
- How will the name sound in customer service interactions?
- What operational implications does the name have?

Take time to think through these aspects before creating names. Let this analysis inform every naming decision.";
    }

    /**
     * Build domain-friendly considerations.
     */
    protected function buildDomainGuidance(string $mode): string
    {
        return "🌐 DOMAIN & DIGITAL CONSIDERATIONS

DOMAIN AVAILABILITY:
- Prioritize names where .com domain is likely available
- Avoid names too similar to existing major websites
- Consider how the name works with common domain extensions
- Think about international domain implications (.co.uk, .de, etc.)
- Avoid hyphens, numbers, or complex spellings in domain names

DIGITAL MARKETING:
- Names should be easy to type on mobile keyboards
- Consider search engine optimization potential
- Think about social media handle availability (@businessname)
- Avoid names that autocorrect to something else
- Consider voice search and smart speaker usage

URL STRUCTURE:
- How will the name work in email addresses (info@businessname.com)?
- Consider subdomain possibilities (blog.businessname.com)
- Think about how the name looks in browser address bars
- Avoid names that create unfortunate URL combinations
- Consider international character handling and encoding

DIGITAL BRANDING:
- How will the name work in app store listings?
- Consider favicon and small icon representations
- Think about how the name displays in social media previews
- Avoid names that are easily misspelled in digital contexts
- Consider hashtag and SEO keyword opportunities";
    }

    /**
     * Build model-specific examples and optimizations.
     */
    protected function buildModelExamples(string $modelId, string $mode, array $businessContext): string
    {
        // Base examples for each mode
        $baseExamples = match ($mode) {
            'creative' => [
                'excellent' => ['Spotify', 'Airbnb', 'Etsy', 'Headspace', 'Sweetgreen', 'Warby Parker', 'Casper', 'Glossier'],
                'analysis' => 'Notice how these names are memorable, evoke positive feelings, and avoid literal descriptions'
            ],
            'professional' => [
                'excellent' => ['Goldman Sachs', 'McKinsey', 'Deloitte', 'Salesforce', 'Palantir', 'Workday', 'ServiceNow', 'Atlassian'],
                'analysis' => 'These names convey authority, expertise, and reliability while being distinctive'
            ],
            'brandable' => [
                'excellent' => ['Google', 'Amazon', 'Nike', 'Apple', 'Tesla', 'Uber', 'Netflix', 'Shopify'],
                'analysis' => 'Short, punchy, and perfect for marketing across all channels'
            ],
            'tech-focused' => [
                'excellent' => ['GitHub', 'Stripe', 'Slack', 'Figma', 'Notion', 'Discord', 'Vercel', 'Supabase'],
                'analysis' => 'Developer-friendly without being generic tech terms'
            ],
            default => [
                'excellent' => ['Spotify', 'Airbnb', 'Etsy', 'Headspace', 'Sweetgreen', 'Warby Parker', 'Casper', 'Glossier'],
                'analysis' => 'Notice how these names are memorable, evoke positive feelings, and avoid literal descriptions'
            ]
        ];

        $examples = $baseExamples[$mode] ?? $baseExamples['creative'];

        // Model-specific enhancement
        $modelNote = match ($modelId) {
            'claude-3.5-sonnet' => "Use your creative and nuanced understanding to craft names with subtle wordplay and cultural depth.",
            'gpt-4' => "Apply systematic analysis to create names that are both logical and emotionally resonant.",
            'gemini-1.5-pro' => "Leverage your multi-perspective thinking to ensure names work across diverse audiences and cultures.",
            'grok-beta' => "Use your unconventional thinking to create bold, memorable names that break industry conventions.",
            default => "Create well-balanced names that combine creativity with practical business considerations."
        };

        $exampleList = implode(', ', $examples['excellent']);

        return "✨ EXCELLENCE EXAMPLES & MODEL OPTIMIZATION

EXEMPLARY NAMES: {$exampleList}

ANALYSIS: {$examples['analysis']}

MODEL-SPECIFIC APPROACH: {$modelNote}

QUALITY BENCHMARKS:
- Each name should be as memorable as the examples above
- Test each name: 'Would I remember this if I heard it once?'
- Ensure each name could potentially become a household brand
- Verify that each name suggests the business value without being literal
- Confirm that each name works for both current scope and future growth

FINAL VALIDATION:
Before finalizing each name, ask:
1. Is this name distinctive in its industry?
2. Would customers confidently recommend this business to friends?
3. Does this name have staying power for the next 20+ years?
4. Could this name support a major brand expansion?
5. Is this name legally protectable and globally scalable?";
    }

}
